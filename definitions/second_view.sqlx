config {
    type: "table",
    schema: "taxi_trips_agg",
    name: "stg_taxi_trips"

}

SELECT unique_key,
taxi_id,
trip_start_timestamp,
trip_end_timestamp,
trip_seconds,
trip_miles,
pickup_community_area,
dropoff_community_area,
fare,
tips,
tolls,
extras,
trip_total,
payment_type,
company
 FROM ${ref("taxi_trips")}
where 
WHERE trip_start_timestamp >= "2023-10-01"
